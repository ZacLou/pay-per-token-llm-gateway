{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.ts",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/**/*.stories.ts",
      "!{projectRoot}/**/*.stories.tsx"
    ],
    "sharedGlobals": ["{workspaceRoot}/.github/workflows/**/*"]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build", "^generate"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "lint": {
      "inputs": ["default", "{workspaceRoot}/.eslintrc.json"],
      "cache": true
    },
    "test": {
      // `^generate` runs the `generate` target of dependency projects, which is
      // how `@x402/database` produces the Prisma client. Any project that
      // imports the client (gateway, dashboard) fails to even load its spec
      // files without it, so a clean clone had to remember the separate
      // `pnpm nx run database:generate` step before `pnpm test` would run.
      // Declaring the edge here makes the documented step self-executing.
      "dependsOn": ["^generate"],
      "inputs": ["default", "^production", "{workspaceRoot}/jest.preset.js"],
      "cache": true
    },
    "@nx/next:build": {
      "inputs": [
        "production",
        "^production",
        {
          "env": "NEXT_PUBLIC_GATEWAY_URL"
        }
      ],
      "cache": true
    }
  },
  "defaultBase": "main",
  "plugins": [
    {
      "plugin": "@nx/next/plugin",
      "options": {
        "buildTargetName": "build",
        "devTargetName": "dev",
        "startTargetName": "start"
      }
    }
  ]
}
