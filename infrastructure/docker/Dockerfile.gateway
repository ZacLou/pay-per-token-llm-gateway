# ── Build Stage ──
FROM node:22-alpine AS builder

WORKDIR /app

# Install pnpm. Node 22 (matching .nvmrc) is required: pnpm 11.24 uses
# `node:sqlite`, which only exists on Node >= 22.13 — on Node 20 the install
# dies with ERR_UNKNOWN_BUILTIN_MODULE. Pin the exact version to match CI
# (PNPM_VERSION) and the root package.json `packageManager` field.
RUN corepack enable && corepack prepare pnpm@11.24.0 --activate

# Copy root workspace files (pnpm-lock.yaml is required for --frozen-lockfile)
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml nx.json tsconfig.base.json ./

# Copy workspace package.json files for dependency resolution
COPY packages/types/package.json packages/types/
COPY packages/shared/package.json packages/shared/
COPY packages/config/package.json packages/config/
COPY packages/logger/package.json packages/logger/
COPY packages/validation/package.json packages/validation/
COPY packages/database/package.json packages/database/
COPY packages/x402-core/package.json packages/x402-core/
COPY packages/wallet/package.json packages/wallet/
COPY packages/authentication/package.json packages/authentication/
COPY packages/analytics/package.json packages/analytics/
COPY packages/notifications/package.json packages/notifications/
COPY apps/gateway/package.json apps/gateway/

# Copy source code
COPY packages/ packages/
COPY apps/gateway/ apps/gateway/
# Copy the esbuild bundling script (required by the `nx build gateway` target)
COPY scripts/ scripts/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Prisma picks which libssl variant of its query engine to download by probing
# the build host. Without the `openssl` CLI it cannot detect OpenSSL 3 on Alpine
# and silently falls back to the OpenSSL 1.1 engine, which then fails to load at
# runtime with `libssl.so.1.1: No such file or directory` (Alpine ships
# libssl.so.3). Install the CLI so the generator selects the
# linux-musl-openssl-3.0.x engine that both stages can load.
RUN apk add --no-cache openssl

# Generate Prisma client
RUN pnpm nx run database:generate

# Build gateway
RUN pnpm exec nx build gateway

# ── Production Stage ──
FROM node:22-alpine

# Provenance labels for supply-chain traceability (also used by container
# scanners to identify the image).
LABEL org.opencontainers.image.title="x402 LLM Gateway" \
      org.opencontainers.image.description="Pay-per-request LLM gateway using x402 stablecoin micropayments on Stellar" \
      org.opencontainers.image.source="https://github.com/mallonepay/pay-per-token-llm-gateway" \
      org.opencontainers.image.licenses="MIT"

WORKDIR /app

# curl for the Docker HEALTHCHECK; openssl so Prisma detects the
# linux-musl-openssl-3.0.x variant at runtime and finds the query engine the
# builder generated (without the CLI it looks for a generic `linux-musl`
# engine that does not exist and the process exits at boot).
RUN apk add --no-cache curl openssl

ENV NODE_ENV=production
# The gateway is shipped as a single esbuild bundle; only @prisma/client
# (native query engine) stays external. NODE_PATH lets the bundle resolve it
# from the workspace package node_modules (pnpm isolated layout).
ENV NODE_PATH=/app/packages/database/node_modules:/app/node_modules

# Copy the self-contained bundle
COPY --from=builder /app/dist/apps/gateway/main.js /app/dist/apps/gateway/main.js

# Copy node_modules (needed for the external @prisma/client + its query engine)
COPY --from=builder /app/node_modules /app/node_modules

# Copy workspace packages (NODE_PATH resolves @prisma/client via
# packages/database/node_modules symlinks into the pnpm store)
COPY --from=builder /app/packages /app/packages

# Container entrypoint: applies pending Prisma migrations, then execs the
# command below. A deploy that skipped migrations used to boot "healthy"
# against an empty database and fail every API call at request time — see
# docker-entrypoint.sh and apps/gateway/src/common/schema-guard.ts.
COPY infrastructure/docker/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod 0755 /usr/local/bin/docker-entrypoint.sh

# Run as an unprivileged user — a compromise of the gateway must not yield
# root on the host. The `node` user ships with the official image.
USER node

EXPOSE 3000

# Liveness probe for orchestrators: the /health endpoint is excluded from
# the api/v1 prefix and answers without dependencies, so this is safe even
# while Postgres/Redis are still warming up (readiness is checked separately
# by the orchestrator against /health/ready).
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:3000/health || exit 1

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["node", "dist/apps/gateway/main.js"]
