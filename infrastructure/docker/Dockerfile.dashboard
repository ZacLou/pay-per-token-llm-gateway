# ── Build Stage ──
FROM node:22-alpine AS builder

WORKDIR /app

# Node 22 (matching .nvmrc) + the exact pnpm CI uses. pnpm 11.24 needs Node
# >= 22.13 (it imports `node:sqlite`), so a Node 20 base fails to install.
RUN corepack enable && corepack prepare pnpm@11.24.0 --activate

# Copy root workspace files needed for pnpm install
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml nx.json tsconfig.base.json ./

# Copy workspace package.json files for dependency resolution
COPY packages/types/package.json packages/types/
COPY packages/shared/package.json packages/shared/
COPY packages/config/package.json packages/config/
COPY packages/logger/package.json packages/logger/
COPY packages/validation/package.json packages/validation/
COPY packages/wallet/package.json packages/wallet/
COPY packages/authentication/package.json packages/authentication/
COPY packages/ui/package.json packages/ui/
COPY packages/database/package.json packages/database/
COPY packages/x402-core/package.json packages/x402-core/
COPY packages/analytics/package.json packages/analytics/
COPY packages/notifications/package.json packages/notifications/
COPY apps/dashboard/package.json apps/dashboard/

# Copy full source code
COPY packages/ packages/
COPY apps/dashboard/ apps/dashboard/

# Install dependencies
RUN pnpm install --frozen-lockfile

# ── Build-time public configuration ──
# NEXT_PUBLIC_* variables are inlined into the dashboard's client bundle by
# Next.js at BUILD time — they are never read from the container environment
# at runtime, so setting one via Kubernetes ConfigMap/env has no effect. Bake
# the public gateway URL into the image here instead. It MUST be a URL the
# *browser* can reach (the ingress host), not an in-cluster Service DNS name.
ARG NEXT_PUBLIC_GATEWAY_URL=http://localhost:3000
ENV NEXT_PUBLIC_GATEWAY_URL=$NEXT_PUBLIC_GATEWAY_URL

# Build dashboard
RUN pnpm exec nx build dashboard

# ── Production Stage ──
FROM node:22-alpine

LABEL org.opencontainers.image.title="x402 Provider Dashboard" \
      org.opencontainers.image.description="Provider dashboard for the x402 LLM gateway" \
      org.opencontainers.image.source="https://github.com/mallonepay/pay-per-token-llm-gateway" \
      org.opencontainers.image.licenses="MIT"

WORKDIR /app

# Install curl for Docker HEALTHCHECK
RUN apk add --no-cache curl

ENV NODE_ENV=production

# Copy standalone server with bundled dependencies.
#
# The `@nx/next:build` executor writes the Next output to the *project*
# directory (`apps/dashboard/.next`). The Nx `outputPath`
# (`dist/apps/dashboard`) only receives next.config.js, package.json and
# public/ — it never contains `.next`. Copying from
# `dist/apps/dashboard/.next/...` (as this file used to) failed the build
# outright: "failed to compute cache key: ... not found".
#
# With `output: 'standalone'` in a monorepo the traced output mirrors the
# repository layout, so the server entrypoint is `apps/dashboard/server.js`
# and its assets sit under `apps/dashboard/.next/static`.
COPY --from=builder /app/apps/dashboard/.next/standalone /app

# Copy static assets (JS bundles, CSS, images)
COPY --from=builder /app/apps/dashboard/.next/static /app/apps/dashboard/.next/static

# Copy public assets (favicon, logo, etc.)
COPY --from=builder /app/apps/dashboard/public /app/apps/dashboard/public

# Run as an unprivileged user.
USER node

# Next's standalone server reads PORT and falls back to 3000. Everything that
# consumes this image — docker-compose's `3001:3001` mapping, the Kubernetes
# Service and its probes, and EXPOSE below — publishes 3001, so the fallback
# listened on the wrong port and the container was never routable or healthy.
# Pin it to the port we actually advertise.
ENV PORT=3001

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:3001/ || exit 1

CMD ["node", "apps/dashboard/server.js"]
