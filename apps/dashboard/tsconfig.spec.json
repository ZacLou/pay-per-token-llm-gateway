{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    // The app config resolves modules with `bundler`, which TS only allows
    // alongside an ESM `module`; jest needs CommonJS output.
    "moduleResolution": "node",
    // The app tsconfig keeps `jsx: "preserve"` for Next's own compiler;
    // ts-jest has no second pass, so specs need the JSX runtime emitted.
    "jsx": "react-jsx",
    "types": ["jest", "node"]
  },
  "include": ["src/**/*.spec.ts", "src/**/*.spec.tsx"]
}
